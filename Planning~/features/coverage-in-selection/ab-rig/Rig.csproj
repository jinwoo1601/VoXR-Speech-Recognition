<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>abrig</AssemblyName>
    <RootNamespace>AbRig</RootNamespace>
    <!-- Entry points. PREFER THE FLAGS: -p:StartupObject= does not survive an
         incremental rebuild, which yields false greens. Dispatch from Program instead:
           (default)              the issue #65 A/B replay
           flag grammar           print GenerateGrammarJson over the demo grammar
           flag joined            the joined-rig mode, score or report (feat-joined-rig-parser)
           flag check             its self-test
           flag sweep             the start-index sweep behind the blocked/recovered figure
           flag doccheck          the issue #83 documentation pin
           flag bench             time and allocation per Parse over the utterances on stdin
           flag prefix-verdicts   the eager verdict over every growing prefix of each utterance
           flag verdicts          the eager verdict beside what the flush would fire
         (each flag is written with two leading dashes on the command line, which an
         XML comment cannot contain.) Only Program and PlayerCheck still carry a Main;
         Check, Sweep, DocCheck and Joined expose Run() and are reached through their
         flags (JoinedReport.Run through Joined); grammar, bench, prefix-verdicts and
         verdicts run inside Program.Main itself. -->
    <StartupObject Condition="'$(StartupObject)' == ''">AbRig.Program</StartupObject>
    <!-- The staged parser sources are shipped code; their warnings are not this rig's
         business and must not fail the build. -->
    <NoWarn>$(NoWarn);CS0414;CS0169;CS0649;CS0618;CS8981</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
