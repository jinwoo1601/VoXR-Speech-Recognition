      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git stash list:*)",
      "Bash(git config --get:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git commit:*)",
      "Bash(python3 .claude/references/vc-git/tree-remove.py:*)",
      "Bash(python3 .claude/references/vc-git/pre-commit-check.py --range:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git show-ref:*)",
      "Bash(git stash create:*)",
      "Bash(git stash store:*)",
      "Bash(python3 ../harness/scripts/harness.py list:*)",
      "Bash(python3 ../harness/scripts/harness.py validate:*)",
      "Bash(python3 ../harness/scripts/harness.py doctor:*)",
      "Bash(python3 ../harness/scripts/harness.py outline:*)",
      "Bash(python3 ../harness/scripts/harness.py budget:*)",
      "Bash(python3 ../harness/scripts/harness.py bounds:*)",
      "Bash(python3 ../harness/scripts/harness.py upgrade --dry-run:*)",
      "Bash(python3 ../harness/scripts/hub.py sessions-at:*)",
      "Bash(python3 ../harness/scripts/hub.py predecessor:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(shred:*)",
      "Bash(dd:*)",
      "Bash(claude *dangerously-skip-permissions*)",
      "Bash(claude *bypassPermissions*)",
