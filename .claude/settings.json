{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(cmp:*)",
      "Bash(tr:*)",
      "Bash(rev:*)",
      "Bash(nl:*)",
      "Bash(fold:*)",
      "Bash(paste:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sleep:*)",
      "Bash(true:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git stash list:*)",
      "Bash(git config --get:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git commit:*)",
      "Bash(python3 .claude/references/vc-git/tree-remove.py:*)",
      "Bash(python3 .claude/references/vc-git/pre-commit-check.py --range:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(shred:*)",
      "Bash(dd:*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(sed -i*)",
      "Bash(sed * -i*)",
      "Bash(sed --in-place*)",
      "Bash(sed * --in-place*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean:*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/doctor-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/references/unity/csharpier-hook.sh\" snapshot"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/report-filer-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/references/unity/csharpier-hook.sh\" format"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/worktree-create-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unity@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "head"
  }
}
