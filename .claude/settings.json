  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/doctor-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" \"${CLAUDE_PROJECT_DIR}\" compact",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$OS\" = Windows_NT ] || { echo 'harness platform check: this machine is not Windows, so the harness guards are off on this machine. Fix: none here - the harness supports Windows only, and macOS and Linux are unsupported (see the README). Tell the user this in your first reply, then carry on with their request.'; exit 0; }; command -v py >/dev/null 2>&1 || echo 'harness platform check: py is not a command here, so the harness guards are off on this machine. Fix: install Python from python.org with the py launcher, then start a new session. Tell the user this in your first reply, then carry on with their request.'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$b = $env:CLAUDE_CODE_GIT_BASH_PATH; if ($b -and (Test-Path -LiteralPath $b -PathType Leaf)) { exit 0 }; $g = Get-Command git -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1; if ($g -and (Test-Path -LiteralPath (Join-Path (Split-Path (Split-Path $g.Source)) 'bin\\bash.exe') -PathType Leaf)) { exit 0 }; if ($env:ProgramFiles -and (Test-Path -LiteralPath (Join-Path $env:ProgramFiles 'Git\\bin\\bash.exe') -PathType Leaf)) { exit 0 }; Write-Output 'harness platform check: Git Bash was not found, so the harness guards are off on this machine. Fix: install Git for Windows, which carries Git Bash, then start a new session. Tell the user this in your first reply, then carry on with their request.'",
            "shell": "powershell",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/release-check-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/release-check-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/report-filer-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/stop-line-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/stop-line-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/task-leftover-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/task-leftover-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unity@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "claudeMdExcludes": [
    "**/Workspace/.claude/rules/CONSTITUTION.md",
    "**/Workspace/CLAUDE.md"
  ]
}
