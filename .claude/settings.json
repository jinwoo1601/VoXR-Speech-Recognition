  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/doctor-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/handoff-guard-hook.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*rm*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(*rM*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(*Rm*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(*RM*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/references/unity/csharpier-hook.sh\" snapshot"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/core/report-filer-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/references/unity/csharpier-hook.sh\" format"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/worktree-create-hook.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unity@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "claudeMdExcludes": [
    "**/Workspace/.claude/rules/CONSTITUTION.md",
    "**/Workspace/CLAUDE.md"
  ]
}
