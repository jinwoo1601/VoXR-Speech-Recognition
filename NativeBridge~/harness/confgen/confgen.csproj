<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>confgen</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Linked, never copied: the conf the harness decodes is the one the package writes. -->
    <Compile Include="../../../Runtime/EndpointerOverlay.cs" Link="EndpointerOverlay.cs" />
  </ItemGroup>
</Project>
